# Business OS: Digital Clinic local-development contract.
# Copy this file to .env and fill secret values locally. Never commit .env.

APP_ENV=development

# PostgreSQL
# Public, local-only development credential used by the documented Docker command.
# Replace it in every shared, staging, or production environment.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=business_os
DATABASE_USER=business_os_app
DATABASE_PASSWORD=business_os_local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application endpoints
BACKEND_PORT=8080
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_PORT=3000
FRONTEND_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Browser and session policy
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Public-form protection. Leave blank until Turnstile is configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Operational limits
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=INFO

# Business OS: Digital Clinic local-development contract.
# Copy this file to .env and fill secret values locally. Never commit .env.

APP_ENV=development

# PostgreSQL
# Public, local-only development credential used by the documented Docker command.
# Replace it in every shared, staging, or production environment.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=business_os
DATABASE_USER=business_os_app
DATABASE_PASSWORD=business_os_local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=business_os_redis_local

# Application endpoints
BACKEND_PORT=8080
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_PORT=3000
FRONTEND_PUBLIC_URL=http://localhost:3000
LOCAL_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Browser and session policy
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=30m
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_SALT=replace-with-a-long-random-value-outside-local-development

# One-time local administrator bootstrap. Enable only for the first backend start,
# then disable it and remove the password from the local .env file.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local administrator

# Public-form protection. Leave blank until Turnstile is configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_EXPECTED_HOSTNAME=

# Operational limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIRECTORY=../uploads
LOG_LEVEL=INFO

# Container image and production-origin contract. Production values should use immutable digests,
# for example ghcr.io/owner/image@sha256:..., and must be supplied outside source control.
BACKEND_IMAGE=business-os-backend:local
FRONTEND_IMAGE=business-os-frontend:local
FRONTEND_BIND_ADDRESS=127.0.0.1

# Production Compose reads secrets from protected files instead of interpolating secret values.
# Keep these files outside the repository and set these paths only in the deployment environment.
DATABASE_PASSWORD_FILE=
REDIS_PASSWORD_FILE=
RATE_LIMIT_KEY_SALT_FILE=
TURNSTILE_SECRET_KEY_FILE=
